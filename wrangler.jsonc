{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "klassenportal-commercial",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-14",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/public/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "klassenportal-commercial",
      "database_id": "REPLACE_WITH_CLOUDFLARE_D1_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "klassenportal-commercial-files"
    }
  ],
  "triggers": {
    "crons": ["17 */6 * * *"]
  }
}
