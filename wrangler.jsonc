{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "klassenportal-commercial",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-14",
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/public/*",
      "/brand/*",
      "/calendar/*",
      "/portal/*",
      "/einrichtung/*",
      "/plattform-admin*",
      "/kunden-admin*",
      "/klassen-admin*",
      "/zahlung/*",
      "/passwort-vergessen*",
      "/passwort-zuruecksetzen*",
      "/konto-aktivieren*",
      "/impressum*",
      "/datenschutz*",
      "/agb*",
      "/avv*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "klassenportal-commercial",
      "database_id": "beaf2c0a-d671-4468-a989-b9932c48f43f"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "klassenportal-commercial-files"
    }
  ],
  "triggers": {
    "crons": ["17 */6 * * *"]
  }
}
