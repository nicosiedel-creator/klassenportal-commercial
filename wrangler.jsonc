{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "klassenportal-commercial",
  "main": "src/exact-onboarding-diagnostic.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [],
  "vars": {
    "APP_ORIGIN": "https://klassenportal.app",
    "MAIL_FROM": "Klassenportal <noreply@klassenportal.app>",
    "INBOUND_MAIL_DOMAIN": "klassenportal.app",
    "PAYMENTS_ENABLED": "false",
    "DATA_RESIDENCY_MODE": "eu_strict",
    "EU_D1_JURISDICTION_ATTESTED": "true",
    "EU_R2_JURISDICTION_ATTESTED": "true",
    "EU_STORAGE_MIGRATION_REQUIRED": "true"
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "klassenportal-commercial-eu",
      "database_id": "a060de73-a4f6-4410-b4f2-25f5bee87754"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "klassenportal-commercial-files-eu",
      "jurisdiction": "eu"
    },
    {
      "binding": "LEGACY_FILES",
      "bucket_name": "klassenportal-commercial-files"
    }
  ]
}
